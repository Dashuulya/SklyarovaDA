<Window x:Class="SklyarovaDA.PasswordChange"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SklyarovaDA"
        mc:Ignorable="d"
                Title="PasswordChange" Height="300" Width="350">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="Green" Offset="0.0"/>
            <GradientStop Color="Yellow" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Смена пароля" 
       FontSize="20"
       FontWeight ="Bold"
       Foreground="#333"
       HorizontalAlignment="Center"
       FontFamily="Bahnschrift"
       Grid.Row="1"/>
        <TextBlock Text="Пароль"
            FontSize="20"
            FontWeight ="Bold"
            Foreground="#333"
            HorizontalAlignment="Center"
            FontFamily="Bahnschrift"
            Grid.Row="2"/>
        <PasswordBox x:Name="txtPassword"
         Background="#FFFFC2"
         BorderBrush="#CCC"
         BorderThickness="2"
         Grid.Row="3"
         Width="250"/>
        <TextBlock Text="Новый пароль"
                   FontSize="20"
                   FontWeight ="Bold"
                   Foreground="#333"
                   HorizontalAlignment="Center"
                   FontFamily="Bahnschrift"
                   Grid.Row="4"/>
        <PasswordBox x:Name="NewPasswordBox"
                     Background="#FFFFC2"
                     BorderBrush="#CCC"
                     BorderThickness="2"
                     Grid.Row="5"
                     Width="250"/>
        <TextBlock Text="Подтвердите новый пароль"
           FontSize="20"
           FontWeight ="Bold"
           Foreground="#333"
           HorizontalAlignment="Center"
           FontFamily="Bahnschrift"
           Grid.Row="6"/>
        <PasswordBox x:Name="ConfirmPasswordBox"
             Background="#FFFFC2"
             BorderBrush="#CCC"
             BorderThickness="2"
             Grid.Row="7"
             Width="250"/>
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" Height="110">
            <Button Content="Сменить" x:Name="SaveButton" Click="ChangeButton_Click" Height="50" Width="70"/>
            <Button Content="Отмена" x:Name="CancelButton" Click="CancelButton_Click" Height="50" Width="70"/>
        </StackPanel>
    </Grid>
</Window>

