<Window x:Class="SklyarovaDA.registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SklyarovaDA"
        mc:Ignorable="d"
        Title="Регистрация" Height="450" Width="800">
    <Window.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="Green" Offset="0.0"/>
        <GradientStop Color="Yellow" Offset="1.0"/>
    </LinearGradientBrush>
</Window.Background>
<Grid Margin="10">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Регистрация" 
       FontSize="20"
       FontWeight ="Bold"
       Foreground="#333"
       HorizontalAlignment="Center"
       FontFamily="Bahnschrift"
       Grid.Row="1"/>
    <TextBlock Text="Роль"  
        FontSize="20"
        FontWeight ="Bold"
        Foreground="#333"
        HorizontalAlignment="Center"
        FontFamily="Bahnschrift"
        Grid.Row="2"/>
    <TextBlock Text="Фамилия" 
        FontSize="20"
        FontWeight ="Bold"
        Foreground="#333"
        HorizontalAlignment="Center"
        FontFamily="Bahnschrift"
        Grid.Row="4"/>
    <TextBlock Text="Имя" 
        FontSize="20"
        FontWeight ="Bold"
        Foreground="#333"
        HorizontalAlignment="Center"
        FontFamily="Bahnschrift"
        Grid.Row="6"/>
    <TextBlock Text="Отчество" 
        FontSize="20"
        FontWeight ="Bold"
        Foreground="#333"
        HorizontalAlignment="Center"
        FontFamily="Bahnschrift"
        Grid.Row="8"/>
    <TextBlock Text="Логин" 
        FontSize="20"
        FontWeight ="Bold"
        Foreground="#333"
        HorizontalAlignment="Center"
        FontFamily="Bahnschrift"
        Grid.Row="12"/>
    <ComboBox Grid.Row="3" Width="250" Height="Auto" >

        <TextBlock>teacher</TextBlock>
        <TextBlock>student</TextBlock>
        <TextBlock>admin</TextBlock>
    </ComboBox>
    <TextBox Grid.Row="5" Width="250" Background="#FFFFC2 " x:Name="LastNameTextBox" />
    <TextBox Grid.Row="7" Width="250" Background="#FFFFC2 " x:Name="FirstNameTextBox" />
    <TextBox Grid.Row="9" Width="250" Background="#FFFFC2 " x:Name="NameTextBox" />
    <TextBox x:Name="txtUsername"
                 Background="#FFFFC2"
                 BorderBrush="#CCC"
                 BorderThickness="2"
             Grid.Row="13"
             Width="250"/>
</Grid>
        
</Window>
